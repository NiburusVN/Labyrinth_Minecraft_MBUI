@startuml
skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam style strictuml
hide empty members

package model{
    class Player{
        +<<Create>> Player()
        -_posX: Integer
        -_posY: Integer
        +getPosX(): Integer
        +getPosY(): Integer
        +moveTo( posX:Integer, posY:Integer )
    }

    enum "<<enumeration>> \n Entity"{
        OBJECTIF1
        OBJECTIF2
        OBJECTIF3
        OBJECTIF4
        OBJECTIF5
        OBJECTIF6
        OBJECTIF7
        OBJECTIF8
        OBJECTIF9
        OBJECTIF10
        OBJECTIF11
        OBJECTIF12
        OBJECTIF13
        OBJECTIF14
        OBJECTIF15
        OBJECTIF16
        OBJECTIF17
        OBJECTIF18
        OBJECTIF19
        OBJECTIF20
        OBJECTIF21
        OBJECTIF22
        OBJECTIF23
        OBJECTIF24
    }

    enum "<<enumeration>> \n Orientation"{
        NORTH
        SOUTH
        EAST
        WEST
    }

    abstract class TileTemplate <<abstract>>{
        + {abstract} setOrientation()
        +getOrientation(): Orientation
        +setEntity()
        +getEntity(): Entity
    }

    class Hallway extends TileTemplate{
        +<<Create>> Corridor()
        +setOrientation()
    }

    class Intersection extends TileTemplate{
        +<<Create>> Intersection()
        +setOrientation()
    }

    class Corner extends TileTemplate{
        +<<Create>> Corner()
        +setOrientation()
    }

    class StartingTile extends Corner{
        +<<Create>> StartingTile()
        +setOrientation()
    }

    class TileFactory{
        +<<Create>> TileFactory()
        +createCorner() : Corner
        +createIntersection() : Intersection
        +createHallway() : Hallway
        +createStartingTile(): StartingTile
    }

    class GameBoard{
        +<<Create>> GameBoard()
        +init_board( tileFactory:TileFactory )
        +moveTiles( tileInHand:TileTemplate, posX: Integer, posY: Integer)
    }

    interface GameObserver <<interface>>{
        +updateGameBoardTiles()
        +updatePlayersPosition()
        +updateSpecialCards()
        +updateGameStatus()
    }
}

package view{
    class GameWindow implements model.GameObserver{
        +<<Create>> GameWindow( controller:GameController )
    }

    class EndingWindow implements model.GameObserver{
        +<<Create>> EndingWindow( controller:GameController )
    }
}

package controller{
    class GameController{
        +<<Create>> GameController(gameboard:GameBoard, players:Player[4])
    }
}



TileFactory ..> TileTemplate :<<uses>>
TileFactory ..> Hallway :<<uses>>
TileFactory ..> StartingTile :<<uses>>
TileFactory ..> Intersection :<<uses>>
TileFactory ..> Corner :<<uses>>

GameBoard ..> TileFactory :<<uses>>
GameBoard ..> TileTemplate :<<uses>>

TileTemplate *-> "1\n- _orientation" "<<enumeration>> \n Orientation" : > points to
TileTemplate o-> "1\n- _entity" "<<enumeration>> \n Entity": > has
GameWindow ..> GameController :<<uses>>

Player o-> "6\n- _entityInProgress" "<<enumeration>> \n Entity": > has
Player o-> "6\n- _entityAccomplished" "<<enumeration>> \n Entity": > has

GameController *-> "4\n- _players" Player: > has
GameController *-> "1\n- _gameboard" GameBoard: > has

GameWindow *-> "1\n- controller" GameController: > send user requests
GameBoard o-> "*\n- _observers" "GameObserver": > observe
Player o-> "*\n- _observers" "GameObserver": > observe

@enduml