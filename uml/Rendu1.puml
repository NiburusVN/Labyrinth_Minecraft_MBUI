@startuml
scale 2
skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam style strictuml
skinparam linetype ortho
hide empty members

' Ajuster les marges et espacements pour allonger les flèches
skinparam padding 10
skinparam classPadding 20
skinparam classMargin 40
skinparam ranksep 100
skinparam nodesep 100
skinparam ArrowFontSize 10
skinparam ArrowColor black
skinparam ArrowThickness 1

package model {
    class Player {
        +<<Create>> Player()
        -_posX: Integer
        -_posY: Integer
        +getPosX(): Integer
        +getPosY(): Integer
        +moveTo(posX: Integer, posY: Integer)
    }

    enum "<<enumeration>> \n Entity" {
        OBJECTIF1
        OBJECTIF2
        OBJECTIF3
        OBJECTIF4
        OBJECTIF5
        OBJECTIF6
        OBJECTIF7
        OBJECTIF8
        OBJECTIF9
        OBJECTIF10
        OBJECTIF11
        OBJECTIF12
        OBJECTIF13
        OBJECTIF14
        OBJECTIF15
        OBJECTIF16
        OBJECTIF17
        OBJECTIF18
        OBJECTIF19
        OBJECTIF20
        OBJECTIF21
        OBJECTIF22
        OBJECTIF23
        OBJECTIF24
    }

    enum "<<enumeration>> \n Direction" {
        NORTH
        SOUTH
        EAST
        WEST
    }

    abstract class TileTemplate <<abstract>> {
        + {abstract} setOrientation()
        +getOrientation(): Direction
        +setEntity()
        +getEntity(): Entity
    }

    class Hallway extends TileTemplate {
        +<<Create>> Corridor()
        +setOrientation()
    }

    class Intersection extends TileTemplate {
        +<<Create>> Intersection()
        +setOrientation()
    }

    class Corner extends TileTemplate {
        +<<Create>> Corner()
        +setOrientation()
    }

    class StartingTile extends Corner {
        +<<Create>> StartingTile()
        +setOrientation()
    }

    class TileFactory {
        +<<Create>> TileFactory()
        +createCorner(): Corner
        +createIntersection(): Intersection
        +createHallway(): Hallway
        +createStartingTile(): StartingTile
    }

    class GameBoard {
        +<<Create>> GameBoard()
        +init_board(tileFactory: TileFactory)
        +moveTiles(posX: Integer, posY: Integer)
    }

    interface GameObserver <<interface>> {
        +updateGameBoardTiles()
        +updatePlayersPosition()
        +updateSpecialCards()
        +updateGameStatus()
    }
}

package view {
    class GameWindow implements model.GameObserver {
        +<<Create>> GameWindow(controller: GameController)
    }

    class EndingWindow implements model.GameObserver {
        +<<Create>> EndingWindow(controller: GameController)
    }
}

package controller {
    class GameController {
        +<<Create>> GameController(gameboard: GameBoard, players: Player[4])
    }
}

' Relations entre les classes, avec cardinalités, libellés, et directions
TileFactory "1" ..> "1" TileTemplate : <<uses>>
TileFactory "1" ..> "1" Hallway : <<uses>>
TileFactory "1" ..> "1" StartingTile : <<uses>>
TileFactory "1" ..> "1" Intersection : <<uses>>
TileFactory "1" ..> "1" Corner : <<uses>>

GameBoard "1" ..> "1" TileFactory : <<uses>>

TileTemplate "1" *-left-> "1\n- _orientation" "<<enumeration>> \n Direction" : > points to
TileTemplate "1" o-right-> "1\n- _entity" "<<enumeration>> \n Entity" : > has

GameWindow "1" ..> "1" GameController : <<uses>>

Player "1" o-right-> "6\n- _entitiesDeck" "<<enumeration>> \n Entity" : > has

GameController "1" *-down-> "4\n  -_players" Player : > has
GameController "1" *-up-> "1\n  -_gameboard" GameBoard : > has

GameBoard "1" o-left-> "*\n -_boardTiles" "TileTemplate" : > contains
GameBoard "1" o-right-> "1\n - _extraTile" "TileTemplate" : > has

GameWindow "1" *-down-> "1\n- controller" GameController : > send user requests
GameBoard "*" o-up-> "*\n- _observers" "GameObserver" : > observe
Player "*" o-right-> "*\n- _observers" "GameObserver" : > observe

@enduml